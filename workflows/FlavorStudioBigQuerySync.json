      "parameters": {
        "jsCode": "const recipe = $input.first().json.data;\nconst syncTimestamp = new Date().toISOString();\nconst syncRunId = $execution.id;\n\nif (!recipe.recipeversions || recipe.recipeversions.length === 0) {\n  return [{ json: {\n    _extracted_at: syncTimestamp,\n    _extraction_run_id: syncRunId,\n    _page: \"1\",\n    unique_id: String(recipe.unique_id),\n    recipe_name: recipe.recipe_name ?? \"\",\n    recipe_code: recipe.recipe_code ?? \"\",\n    type: recipe.type ?? \"\",\n    recipe_in_production: \"0\",\n    recipe_archived: \"0\",\n    created: recipe.created ?? \"\",\n    last_modified: recipe.last_modified ?? \"\",\n    recipeversion_version: \"SKIP\",\n    recipeversion_name: \"SKIP\",\n    recipeversion_notes: \"\",\n    entered_batch_size: \"0\",\n    batch_unit: \"\",\n    recipeversionrows_json: \"[]\",\n    tags_json: \"[]\",\n  }}];\n}\n\nconst rows = [];\n\nfor (const version of recipe.recipeversions) {\n  rows.push({\n    _extracted_at: syncTimestamp,\n    _extraction_run_id: syncRunId,\n    _page: \"1\",\n    unique_id: String(recipe.unique_id),\n    recipe_name: recipe.recipe_name,\n    recipe_code: recipe.recipe_code,\n    type: recipe.type,\n    recipe_in_production: String(recipe.recipe_in_production),\n    recipe_archived: String(recipe.recipe_archived),\n    created: recipe.created,\n    last_modified: recipe.last_modified,\n    recipeversion_version: String(version.recipeversion_version),\n    recipeversion_name: version.recipeversion_name,\n    recipeversion_notes: version.recipeversion_notes,\n    entered_batch_size: String(version.entered_batch_size),\n    batch_unit: version.batch_unit,\n    recipeversionrows_json: JSON.stringify(version.recipeversionrows),\n    tags_json: JSON.stringify(recipe.tags),\n  });\n}\n\nreturn rows.map(row => ({ json: row }));"
      },
